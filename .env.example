# Copy to `.env` and fill in the values you need. `.env` is gitignored.
# Only the keys for the providers you actually run are required.

# --- LLM / VLM providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_KEY=

# Azure OpenAI (needed only for the gpt-5-mini route)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional endpoint overrides (defaults are the public APIs)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Local data / cache roots ---
# Where benchmark videos and images live.
REASMORY_DATA_ROOT=/path/to/data
# Scratch space for rendered tool outputs (BEV/ego renders, session artifacts).
REASMORY_WORKSPACE_ROOT=/path/to/workspace
# Precomputed static reconstruction caches (Pi3 = non-metric, Pi3x = metric).
REASMORY_SPATIAL_MEMORY_CACHE=/path/to/spatial_memory_cache
REASMORY_SPATIAL_MEMORY_CACHE_PI3X=/path/to/spatial_memory_cache_pi3x
# Precomputed dynamic (Flow3R) reconstruction cache, keyed by video.
REASMORY_DYNAMIC_MEMORY_CACHE=/path/to/flow3r_cache/by_video

# --- Model checkpoints ---
# REASMORY_PI3_CKPT=/path/to/pi3.safetensors
# REASMORY_SAM3_CKPT=/path/to/sam3
